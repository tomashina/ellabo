{% if (registry.has('theme_options') == constant('true')) %} 
     {% set theme_options = registry.get('theme_options') %}
     <div class="standard-body{% if (disable_on_desktop == 1) %} {{ ' hidden-lg hidden-md' }} {% endif %} {% if (disable_on_mobile == 1) %} {{ ' hidden-sm hidden-xs' }} {% endif %}" id="header-notice-{{ id }}">
          {% if theme_options.get( 'load_styles' ) == 'fashion_simple_1.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_2.css' %}
               <div class="full-width clearfix">
                    <div class="container">
                         <div class="header-notice">
                              <a href="#" class="close-notice"></a>
                              {{ text }}
                         </div>
                    </div>
               </div>
          {% else %}
               <div class="header-notice full-width clearfix">
                    <a href="#" class="close-notice"></a>
                    <div class="container">
                         <p>{{ text }}</p>
                    </div>
               </div>
          {% endif %}
     </div>

     <style type="text/css">
          {% if (background_color != '') %} 
          #header-notice-{{ id }} .header-notice {
               background: {{ background_color }};
          }
          {% endif %} 
          
          {% if (text_color != '') %} 
          #header-notice-{{ id }} .header-notice,
          #header-notice-{{ id }} .header-notice a {
               color: {{ text_color }};
          }
          {% endif %} 
          
          {% if (text_link_hover_color != '') %} 
          #header-notice-{{ id }} .header-notice a:hover {
               color: {{ text_link_hover_color }};
          }
          {% endif %} 
          
          {% if (close_button_background_color != '') %} 
          #header-notice-{{ id }} .header-notice a.close-notice {
               background: {{ close_button_background_color }};
          }
          {% endif %} 
          
          {% if (close_button_hover_background_color != '') %} 
          #header-notice-{{ id }} .header-notice a.close-notice:hover {
               background: {{ close_button_hover_background_color }};
          }
          {% endif %} 
          
          {% if (close_button_text_color != '') %} 
          #header-notice-{{ id }} .header-notice a.close-notice {
               color: {{ close_button_text_color }};
          }
          {% endif %} 
          
          {% if (close_button_hover_text_color != '') %} 
          #header-notice-{{ id }} .header-notice a.close-notice:hover {
               color: {{ close_button_hover_text_color }};
          }
          {% endif %} 
     </style>

     <script type="text/javascript">
          {% if (show_only_once == 1) %} 
          if (localStorage.getItem('displayNotice') != 'yes') {
          {% endif %} 
          
          $("#header-notice-{{ id }} .header-notice").show();
          
          $('#header-notice-{{ id }} .close-notice').on('click', function () {
               {% if (show_only_once == 1) %} 
               localStorage.setItem('displayNotice', 'yes');
               {% endif %} 
               $("#header-notice-{{ id }} .header-notice").hide();
               return false;
          });
          
          {% if (show_only_once == 1) %} 
          } 
          {% endif %} 
     </script>
{% endif %}