			}, function() {            
				$(".twitter_right").stop(true, false).animate({right: "-250"}, 800, 'easeInQuint');        
			}, 1000);    
		
			$(".twitter_left").hover(function() {            
				$(".twitter_left").stop(true, false).animate({left: "0"}, 800, 'easeOutQuint');        
