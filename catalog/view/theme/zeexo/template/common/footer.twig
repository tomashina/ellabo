{% if (registry.has('theme_options') == constant('true')) %} 
     {% set theme_options = registry.get('theme_options') %}
     {% set config = registry.get('config') %}
          
     {# Pobranie zmiennych #}          
     {% set footer_center = theme_options.getModules('footer') %}

     {% set customfooter_top = theme_options.getModules('customfooter_top') %}
     {% if ( customfooter_top|length > 0 ) %} 
          {% for module in customfooter_top %} 
               {{ module }}
          {% endfor %}
     {% endif %} 
     
     <!-- FOOTER
          ================================================== -->
     <div class="footer {% if (theme_options.get( 'footer_layout' ) == 2) %} {{ 'fixed' }} {% else %} {{ 'full-width' }} {% endif %}">
          <div class="background-footer"></div>
          <div class="background">
               <div class="shadow"></div>
               <div class="pattern">
                    <div class="container">
                         
                         {% set footer_top = theme_options.getModules('footer_top') %}
                         {% if ( footer_top|length > 0 ) %} 
                              {% for module in footer_top %} 
                                   {{ module }}
                              {% endfor %}
                         {% endif %} 
                         
                         
                         {% if ( footer_center|length > 0 ) %} 
                              {% for module in footer_center %} 
                                   {{ module }}
                              {% endfor %}
                         {% else %} 
                              <div class="row">
                                   
                              {% set footer_left = theme_options.getModules('footer_left') %}
                              {% set footer_right = theme_options.getModules('footer_right') %}
                              
                              {% set span = 3 %}
                              {% if ( footer_left|length > 0 and footer_right|length > 0 ) %}
                                   {% set span = 2 %}
                              {% elseif ( footer_left|length > 0 or footer_right|length > 0 ) %}
                                   {% set span = 25 %}
                              {% endif %} 
                                   
                                   {% if ( footer_left|length > 0 ) %} 
                                   <div class="col-md-{{ span }}">
                                   {% for module in footer_left %} 
                                        {{ module }}
                                   {% endfor %} 
                                   </div>
                                   {% endif %} 
                                   
                                   <!-- Information -->
                                   <div class="col-md-{{ span }}">
                                        <h4>{{ text_information }}</h4>
                                        <div class="strip-line"></div>
                                        <ul>
                                             {% for information in informations %} 
                                             <li><a href="{{ information['href'] }}">{{ information['title'] }}</a></li>
                                             {% endfor %} 
                                        </ul>
                                   </div>
                                   
                                   <!-- Customer Service -->
                                   <div class="col-md-{{ span }}">
                                        <h4>{{ text_service }}</h4>
                                        <div class="strip-line"></div>
                                        <ul>
                                             <li><a href="{{ contact }}">{{ text_contact }}</a></li>
                                             <li><a href="{{ return }}">{{ text_return }}</a></li>
                                             <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
                                        </ul> 
                                   </div>
                                   
                                   <!-- Extras -->
                                   <div class="col-md-{{ span }}">
                                        <h4>{{ text_extra }}</h4>
                                        <div class="strip-line"></div>
                                        <ul>
                                             <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
                                             <li><a href="{{ voucher }}">{{ text_voucher }}</a></li>
                                             <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
                                             <li><a href="{{ special }}">{{ text_special }} </a></li>
                                        </ul>
                                   </div>
                                   
                                   <!-- My Account -->
                                   <div class="col-md-{{ span }}">
                                        <h4>{{ text_account }}</h4>
                                        <div class="strip-line"></div>
                                        <ul>
                                             <li><a href="{{ account }}">{{ text_account }}</a></li>
                                             <li><a href="{{ order }}">{{ text_order }}</a></li>
                                             <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
                                             <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
                                        </ul>
                                   </div>
                                   
                                   {% if (footer_right|length > 0 ) %} 
                                   <div class="col-md-{{ span }}">
                                   {% for module in footer_right %} 
                                        {{ module }}
                                   {% endfor %} 
                                   </div>
                                   {% endif %} 
                              </div>
                         {% endif %} 
                         
                         
                         {% set footer_bottom = theme_options.getModules('footer_bottom') %}
                         {% if ( footer_bottom|length > 0 ) %} 
                              {% for module in footer_bottom %} 
                                   {{ module }}
                              {% endfor %}
                         {% endif %} 
                    </div>
               </div>
          </div>
     </div>
     
     <!-- COPYRIGHT
          ================================================== -->
     <div class="copyright {% if (theme_options.get( 'footer_layout' ) == 2) %} {{ 'fixed' }} {% else %} {{ 'full-width' }} {% endif %}">
          <div class="background-copyright"></div>
          <div class="background">
               <div class="shadow"></div>
               <div class="pattern">
                    <div class="container">
                         {% set bottom = theme_options.getModules('bottom') %}
                         {% if ( bottom|length > 0 ) %} 
                              {% for module in bottom %} 
                                   {{ module }}
                              {% endfor %}
                         {% endif %}             
                    </div>
               </div>
          </div>
     </div> 

     {% set under_footer = theme_options.getModules('under_footer') %}
     {% if ( under_footer|length > 0 ) %} 
          {% for module in under_footer %} 
               {{ module }}
          {% endfor %}
     {% endif %} 
     <script type="text/javascript" src="catalog/view/theme/zeexo/js/megamenu.js"></script>
</div>

<!-- modal (AddToCartProduct) -->
<div class="modal  fade"  id="modalAddToCartProduct" tabindex="-1" role="dialog" aria-label="myModalLabel" aria-hidden="true">
     <div class="modal-dialog">
          <div class="modal-content ">
               <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"><span class="icon icon-clear"></span></button>
               </div>
               <div class="modal-body">
                    <div class="tt-modal-addtocart mobile">
                         <div class="tt-modal-messages">
                              <i class="fas fa-check"></i> {% if (theme_options.get( 'added_to_cart_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'added_to_cart_text', config.get( 'config_language_id' ) ) }}{% else %}Added to cart successfully!{% endif %}
                         </div>
                         <a href="#" class="btn-link btn-close-popup">{% if (theme_options.get( 'continue_shopping_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'continue_shopping_text', config.get( 'config_language_id' ) ) }}{% else %}CONTINUE SHOPPING{% endif %}</a>
                       <a href="{{ theme_options.getLinkOpenCart('checkout/cart') }}" class="btn-link">{% if (theme_options.get( 'view_cart_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'view_cart_text', config.get( 'config_language_id' ) ) }}{% else %}VIEW CART{% endif %}</a>
                       <a href="{{ theme_options.getLinkOpenCart('checkout/checkout') }}" class="btn-link">{% if (theme_options.get( 'proceed_to_checkout_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'proceed_to_checkout_text', config.get( 'config_language_id' ) ) }}{% else %}PROCEED TO CHECKOUT{% endif %}</a>
                    </div>
                    <div class="tt-modal-addtocart desctope">
                         <div class="d-flex">
                              <div class="left">
                                   <div class="tt-modal-messages">
                                        <i class="fas fa-check"></i> {% if (theme_options.get( 'added_to_cart_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'added_to_cart_text', config.get( 'config_language_id' ) ) }}{% else %}Added to cart successfully!{% endif %}
                                   </div>
                                   <div class="tt-modal-product">
                                        <div class="tt-img">
                                             <img src="{% if theme_options.get( 'lazy_loading_images_size') == 2 %}image/catalog/blank2.gif{% else %}image/catalog/blank.gif{% endif %}" alt="">
                                        </div>
                                        <h2 class="tt-title"><a href="product.html">Flared Shift Dress</a></h2>
                                        <div class="tt-qty">
                                             {% if (theme_options.get( 'qty_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'qty_text', config.get( 'config_language_id' ) ) }}{% else %}Qty{% endif %}: <span>1</span>
                                        </div>
                                   </div>
                                   <div class="tt-product-total">
                                        <div class="tt-total">
                                             <span class="tt-price">$324</span>
                                        </div>
                                   </div>
                              </div>
                              <div class="right">
                                   <div class="tt-cart-total">
                                        <p class="text-total" style="margin: 0px">{% if (theme_options.get( 'there_are_one_items_in_your_cart_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'there_are_one_items_in_your_cart_text', config.get( 'config_language_id' ) ) }}{% else %}There are 1 items in your cart{% endif %}</p>
                                        <div class="tt-total">
                                             {% if (theme_options.get( 'total_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'total_text', config.get( 'config_language_id' ) ) }}{% else %}Total{% endif %}: <span class="tt-price">$324</span>
                                        </div>
                                   </div>
                                   <a href="#" class="btn btn-border btn-close-popup">{% if (theme_options.get( 'continue_shopping_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'continue_shopping_text', config.get( 'config_language_id' ) ) }}{% else %}CONTINUE SHOPPING{% endif %}</a>
                                   <a href="{{ theme_options.getLinkOpenCart('checkout/cart') }}" class="btn btn-border">{% if (theme_options.get( 'view_cart_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'view_cart_text', config.get( 'config_language_id' ) ) }}{% else %}VIEW CART{% endif %}</a>
                                   <a href="{{ theme_options.getLinkOpenCart('checkout/checkout') }}" class="btn">{% if (theme_options.get( 'proceed_to_checkout_text', config.get( 'config_language_id' ) ) != '') %}{{ theme_options.get( 'proceed_to_checkout_text', config.get( 'config_language_id' ) ) }}{% else %}PROCEED TO CHECKOUT{% endif %}</a>
                              </div>
                         </div>
                    </div>
               </div>
          </div>
     </div>
</div>

<a href="#" class="scrollup"><i class="fa fa-chevron-up"></i></a>
</div>
</div>
{% endif %} 
</body>
</html>