{{ header }}
{% include 'zeexo/template/new_elements/wrapper_top.twig' %}

{% if error_warning %}
<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
{% endif %}

<p>{{ text_description }}</p>

<form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal" id="return-form">
  <input type="hidden" name="order_id" value="{{ order_id|e }}" />
  <fieldset>
    <legend>{{ text_order }}</legend>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-firstname">{{ entry_firstname }}</label>
      <div class="col-md-10">
        <input type="text" name="firstname" value="{{ firstname|e }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" maxlength="32" autocomplete="given-name" required />
        {% if error_firstname %}<div class="text-danger">{{ error_firstname }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-lastname">{{ entry_lastname }}</label>
      <div class="col-md-10">
        <input type="text" name="lastname" value="{{ lastname|e }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" maxlength="32" autocomplete="family-name" required />
        {% if error_lastname %}<div class="text-danger">{{ error_lastname }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-email">{{ entry_email }}</label>
      <div class="col-md-10">
        <input type="email" name="email" value="{{ email|e }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" maxlength="96" autocomplete="email" required />
        {% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-telephone">{{ entry_telephone }}</label>
      <div class="col-md-10">
        <input type="tel" name="telephone" value="{{ telephone|e }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" maxlength="32" autocomplete="tel" required />
        {% if error_telephone %}<div class="text-danger">{{ error_telephone }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-invoice-number">{{ entry_invoice_number }}</label>
      <div class="col-md-10">
        <input type="text" name="invoice_number" value="{{ invoice_number|e }}" placeholder="{{ entry_invoice_number }}" id="input-invoice-number" class="form-control" maxlength="64" required />
        {% if error_order_id %}<div class="text-danger">{{ error_order_id }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-invoice-date">{{ entry_invoice_date }}</label>
      <div class="col-md-4">
        <input type="date" name="invoice_date" value="{{ invoice_date|e }}" id="input-invoice-date" class="form-control" required />
        {% if error_date_ordered %}<div class="text-danger">{{ error_date_ordered }}</div>{% endif %}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{ text_product }}</legend>
    <input type="hidden" name="product_id" value="{{ product_id|e }}" />

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center">{{ text_return_products_title }}</label>
      <div class="col-md-10">
        <div class="table-responsive">
          <table id="return-product" class="table table-bordered">
            <thead>
              <tr>
                <th>{{ entry_product_code }}</th>
                <th style="width: 130px;">{{ entry_quantity }}</th>
                <th style="width: 180px;">{{ entry_price }}</th>
                <th style="width: 55px;"></th>
              </tr>
            </thead>
            <tbody>
              {% for product_row, return_product in return_products %}
              <tr>
                <td><input type="text" name="return_products[{{ product_row }}][code]" value="{{ return_product.code|e }}" placeholder="{{ entry_product_code }}" class="form-control" maxlength="64" required /></td>
                <td><input type="number" name="return_products[{{ product_row }}][quantity]" value="{{ return_product.quantity|e }}" placeholder="{{ entry_quantity }}" class="form-control" min="1" max="9999" step="1" required /></td>
                <td><input type="text" name="return_products[{{ product_row }}][price]" value="{{ return_product.price|e }}" placeholder="{{ entry_price }}" class="form-control" maxlength="32" inputmode="decimal" required /></td>
                <td class="text-center"><button type="button" class="btn btn-outline button-remove-return-product" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
              </tr>
              {% endfor %}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3"></td>
                <td class="text-center"><button type="button" id="button-return-product" class="btn btn-outline" title="{{ button_add_product }}"><i class="fa fa-plus-circle"></i></button></td>
              </tr>
            </tfoot>
          </table>
        </div>
        {% if error_return_products %}<div class="text-danger">{{ error_return_products }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center">{{ entry_reason }}</label>
      <div class="col-md-10">
        {% for return_reason in return_reasons %}
        <div class="radio">
          <label>
            <input type="radio" name="return_reason_id" value="{{ return_reason.return_reason_id }}"{% if return_reason.return_reason_id == return_reason_id %} checked="checked"{% endif %} required />
            {{ return_reason.name|e }}
          </label>
        </div>
        {% endfor %}
        {% if error_reason %}<div class="text-danger">{{ error_reason }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row required">
      <label class="col-md-2 control-label align-self-center" for="input-refund-iban">{{ entry_refund_iban }}</label>
      <div class="col-md-10">
        <input type="text" name="refund_iban" value="{{ refund_iban|e }}" placeholder="{{ entry_refund_iban }}" id="input-refund-iban" class="form-control" maxlength="64" autocomplete="off" required />
        {% if error_refund_iban %}<div class="text-danger">{{ error_refund_iban }}</div>{% endif %}
      </div>
    </div>

    <div class="form-group row">
      <label class="col-md-2 control-label align-self-center" for="input-comment">{{ entry_fault_detail }}</label>
      <div class="col-md-10">
        <textarea name="comment" rows="6" placeholder="{{ entry_fault_detail }}" id="input-comment" class="form-control" maxlength="2000">{{ comment|e }}</textarea>
      </div>
    </div>

    {{ captcha }}
  </fieldset>

  {% if text_agree %}
  <div class="buttons clearfix">
    <div class="pull-left"><a href="{{ back }}" class="btn btn-danger">{{ button_back }}</a></div>
    <div class="pull-right">
      <label>{{ text_agree }} <input type="checkbox" name="agree" value="1"{% if agree %} checked="checked"{% endif %} required /></label>
      <input type="submit" value="{{ button_submit }}" class="btn btn-primary" />
    </div>
  </div>
  {% else %}
  <div class="buttons clearfix text-right">
    <input type="submit" value="{{ button_submit }}" class="btn btn-primary" />
  </div>
  {% endif %}
</form>

<script type="text/javascript"><!--
var returnProductRow = {{ return_products|length }};

$('#button-return-product').on('click', function() {
  if ($('#return-product tbody tr').length >= 20) {
    return;
  }

  var row = $('#return-product tbody tr:first').clone();

  row.find('input').each(function() {
    var input = $(this);
    var name = input.attr('name').replace(/return_products\[\d+\]/, 'return_products[' + returnProductRow + ']');

    input.attr('name', name).val(name.indexOf('[quantity]') !== -1 ? '1' : '');
  });

  $('#return-product tbody').append(row);
  returnProductRow++;
});

$('#return-product').on('click', '.button-remove-return-product', function() {
  if ($('#return-product tbody tr').length === 1) {
    $(this).closest('tr').find('input').val('');
    $(this).closest('tr').find('input[name$="[quantity]"]').val('1');
  } else {
    $(this).closest('tr').remove();
  }
});
//--></script>

{% include 'zeexo/template/new_elements/wrapper_bottom.twig' %}
{{ footer }}
