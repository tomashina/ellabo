{% set product_over_tabs = theme_options.getModules('product_over_tabs') %}
{% if ( product_over_tabs|length > 0 ) %} 
	{% for module in product_over_tabs %} 
		{{ module }}
	{% endfor %}
{% endif %} 

<div id="accordion2">
	{% set language_id = config.get( 'config_language_id' ) %}
	{% set tabs = [] %}
	{% set tabs = tabs | merge([{'content': 'description', 'heading': tab_description, 'sort': 1 }]) %}

	{% if (attribute_groups) %} 
	{% set tabs = tabs | merge([{'content': 'attribute', 'heading': tab_attribute, 'sort': 3 }]) %}
	{% endif %}

	{% if (review_status) %} 
	{% set tabs = tabs | merge([{'content': 'review', 'heading': tab_review, 'sort': 5 }]) %}
	{% endif %} 

	{% if (config.get('product_tabs') is iterable) %}
		{% for tab in config.get('product_tabs') %} 
			{% if (tab['status'] == 1 or tab['product_id'] == product_id) %}
				{% for zakladka in tab['tabs'] %} 
					{% if (zakladka['status'] == 1) %}
						{% set heading = constant('false') %} 
						{% set content = constant('false') %}
						{% if (zakladka[language_id] is defined) %}
							{% set heading = zakladka[language_id]['name'] %}
							{% set content = theme_options.html_entity_decode(zakladka[language_id]['html']) %}
						{% endif %}
						{% set tabs = tabs | merge([{'content': content, 'heading': heading, 'sort': zakladka['sort_order'] }]) %}
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
	{% endif %} 

	{% set tabs_test = theme_options.usort(tabs) %}

	{% for tab in tabs_test  %} 
		<div class="card">
		    <div class="card-header" id="heading{{ loop.index }}">
		      <h5 class="mb-0">
		        <button class="btn-link{% if loop.index != 1 %} collapsed{% endif %}" data-toggle="collapse" data-target="#collapse{{ loop.index }}" aria-expanded="true" aria-controls="collapse{{ loop.index }}">
		          {{ tab['heading'] }}
		        </button>
		      </h5>
		    </div>
		    <div id="collapse{{ loop.index }}" class="collapse{% if loop.index == 1 %} show{% endif %}" aria-labelledby="heading{{ loop.index }}" data-parent="#accordion2">
		      <div class="card-body">
			 	{% if (tab['content'] != 'description' and tab['content'] != 'attribute' and tab['content'] != 'review') %}
			 		<div class="card-body-auto">{{ tab['content'] }}</div>
			 	{% else %}
			 		{% if tab['content'] == 'description' %}
			 			<div class="card-body-auto">{{ description }}</div>
			 		{% endif %}
			 		{% if tab['content'] == 'attribute' %}
						{% if (attribute_groups) %} 
							<div class="size-chart-table card-body-auto">
								<table class="attribute" cellspacing="0">
								  {% for attribute_group in attribute_groups %} 
								  <thead>
								    <tr>
								      <td colspan="2">{{ attribute_group['name'] }}</td>
								    </tr>
								  </thead>
								  <tbody>
								    {% for attribute in attribute_group['attribute'] %} 
								    <tr>
								      <td>{{ attribute['name'] }}</td>
								      <td>{{ attribute['text'] }}</td>
								    </tr>
								    {% endfor %} 
								  </tbody>
								  {% endfor %} 
								</table>
							</div>
						{% endif %}
			 		{% endif %}
			 		{% if tab['content'] == 'review' %}
						<div id="tab-review">
							<div class="comment-heading">
								<h2>{{ tab_review }}</h2>
							      <div class="review">
							        <div class="rating"><i class="fa fa-star{% if (rating >= 1) %} {{ ' active' }} {% endif %}"></i><i class="fa fa-star{% if (rating >= 2) %} {{ ' active' }} {% endif %}"></i><i class="fa fa-star{% if (rating >= 3) %} {{ ' active' }} {% endif %}"></i><i class="fa fa-star{% if (rating >= 4) %} {{ ' active' }} {% endif %}"></i><i class="fa fa-star{% if (rating >= 5) %} {{ ' active' }} {% endif %}"></i>&nbsp;&nbsp;&nbsp;<a onclick="$('a[href=\'#tab-review\']').trigger('click'); $('html, body').animate({scrollTop:$('#tab-review').offset().top}, '500', 'swing');">{{ reviews }}</a></div>
							      </div>
								<a href="#" class="btn btn-default">{{ text_write }}</a>
							</div>
							<div id="review"></div>
						</div>
						<div id="popup-comments" class="popup reply-block mfp-hide"><div id="reply-block">
							<h4>{{ text_write }}</h4> 
							<form class="form-horizontal" id="form-review">
							  {% if (review_guest) %} 
							  <div class="form-group row required">
							    <div class="col-md-12">
							      <label class="control-label" for="input-name">{{ entry_name }}</label>
							      <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" />
							    </div>
							  </div>
							  <div class="form-group row required">
							    <div class="col-md-12">
							      <label class="control-label" for="input-review">{{ entry_review }}</label>
							      <textarea name="text" rows="5" id="input-review" class="form-control"></textarea>
							      <div class="help-block">{{ text_note }}</div>
							    </div>
							  </div>
							  <div class="form-group row required">
							    <div class="col-md-12">
							      <label class="control-label">{{ entry_rating }}</label>
							      &nbsp;&nbsp;&nbsp; {{ entry_bad }}&nbsp;
							      <input type="radio" name="rating" value="1" />
							      &nbsp;
							      <input type="radio" name="rating" value="2" />
							      &nbsp;
							      <input type="radio" name="rating" value="3" />
							      &nbsp;
							      <input type="radio" name="rating" value="4" />
							      &nbsp;
							      <input type="radio" name="rating" value="5" />
							      &nbsp;{{ entry_good }}</div>
							  </div>
							  {{ captcha }} 
							  <div class="buttons clearfix" style="margin-bottom: 0px">
							    <div class="">
							      <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary">{{ button_continue }}</button>
							    </div>
							  </div>
							  {% else %} 
							  {{ text_login }} 
							  {% endif %} 
							</form>
						</div></div>

						<script>
						    $(function(){
						        $('.comment-heading .btn-default').click(function(e){
						            $.magnificPopup.open({
						                items: {
						                    src: '#popup-comments',
						                    type: 'inline'
						                },
						                tLoading: '',
						                mainClass: 'popup-module mfp-with-zoom',
						                removalDelay: 200,
						            });
						            
						            return false;
						            
						        })
						    })
						</script>
			 		{% endif %}
			 	{% endif %}
		      </div>
		    </div>
		</div>
	{% endfor %}
</div>

{% if (tags) %} 
<div class="tags_product"><b>{{ text_tags }}</b>
{% set i = 0 %}{% for i in i..tags %} 
{% if (i < (tags|length - 1)) %} 
<a href="{{ tags[i]['href'] }}">{{ tags[i]['tag'] }}</a>,
{% else %} 
<a href="{{ tags[i]['href'] }}">{{ tags[i]['tag'] }}</a>
{% endif %} 
{% endfor %} 
</div>
{% endif %} 

{% if (products and theme_options.get( 'product_related_status' ) != '0') %} 
  {% set id = random(5000) * random(50000) %}
  <div class="box clearfix box-with-products {% if (theme_options.get( 'product_scroll_related' ) != '0') %} {{ 'with-scroll' }} {% endif %}">
    {% if (theme_options.get( 'product_scroll_related' ) != '0') %} 
    <!-- Carousel nav -->
    <a class="next" href="#myCarousel{{ id }}" id="myCarousel{{ id }}_next"><span></span></a>
    <a class="prev" href="#myCarousel{{ id }}" id="myCarousel{{ id }}_prev"><span></span></a>
    {% endif %} 
    
    <div class="box-heading">{{ text_related }}</div>
    <div class="strip-line"></div>
    <div class="clear"></div>
    <div class="box-content products">
      <div class="box-product">
        <div id="myCarousel{{ id }}">
          {% if (theme_options.get( 'product_scroll_related' ) != '0') %} 
            <div class="owl-carousel">
                <div class="item">
                  <div class="product-grid">
                    {% for product in products %}
                      {% if loop.index > 1 %}</div></div><div class="item"><div class="product-grid">{% endif %}
                      {% include 'zeexo/template/new_elements/product.twig' %}
                    {% endfor %}
                  </div>
                </div>
              </div>
          {% else %}
              <div class="active item">
                <div class="product-grid">
                  <div class="row">
                  {% set class = 'col-6 col-md-4 col-lg-3' %} 
                  {% if (itemsperpage == 6) %} {% set class = 'col-6 col-md-3 col-lg-2' %} {% endif %}
                  {% if (itemsperpage == 5) %} {% set class = 'col-6 col-md-3 col-lg-25' %} {% endif %}
                  {% if (itemsperpage == 3) %} {% set class = 'col-6 col-md-6 col-lg-4' %} {% endif %}
                  {% if (itemsperpage == 2) %} {% set class = 'col-12 col-md-6' %} {% endif %}
                    {% for product in products %}
                      <div class="{{ class }}">
                        {% include 'zeexo/template/new_elements/product.twig' %}
                      </div>
                    {% endfor %} 
                  </div>
                </div>
              </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if (theme_options.get( 'product_scroll_related' ) != '0') %} 
  <script type="text/javascript">
    $(document).ready(function() {
      var owl{{ id }} = $(".box #myCarousel{{ id }} .owl-carousel");
      
      $("#myCarousel{{ id }}_next").click(function(){
          owl{{ id }}.trigger('next.owl.carousel');
          return false;
        })
      $("#myCarousel{{ id }}_prev").click(function(){
          owl{{ id }}.trigger('prev.owl.carousel');
          return false;
      });

    {% set itemsmobile = 2 %}
    {% set itemstablet = 3 %}

    {% if theme_options.get( 'product_per_pow' ) == 2 %}
      {% set itemsmobile = 1 %}
      {% set itemstablet = 2 %}
    {% endif %}

    {% set itemsperpage = 4 %} 
    {% if (theme_options.get( 'product_per_pow' ) > 1) %}{% set itemsperpage = theme_options.get( 'product_per_pow' ) %}{% endif %} 
   
      owl{{ id }}.owlCarousel({
        slideSpeed: 500,
    	{% if theme_options.get( 'load_styles' ) == 'fashion_modern_1.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_2.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_3.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_4.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_5.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_6.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_7.css' or theme_options.get( 'load_styles' ) == 'fashion_modern_8.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_1.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_2.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_3.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_4.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_5.css' or theme_options.get( 'load_styles' ) == 'fashion_simple_6.css' %}
    		margin: 10,
    	{% else %}
    		margin: 30,
    	{% endif %}
        nav: false,
        dots: false,
        responsiveClass:true,
        responsive:{
            0:{
                items:{{ itemsmobile }},
            },
            600:{
                items:{{ itemstablet }},
            },
            1000:{
                items:{{ itemsperpage }},
            }
        }
       });
    });
  </script>
  {% endif %}
{% endif %}