    <script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ heading_title }}",
  "image": [
  	{% if (thumb) %} 
    	"{{ thumb }}",
    {% else %}
    	"image/no_image.jpg"{% if images|length > 0 %},{% endif %}
    {% endif %}
    {% for image in images %} 
    	"{{ image['popup'] }}"{% if not loop.last %},{% endif %}
    {% endfor %}
   ],
  "description": "{{ description|striptags|raw|trim }}",
  {% if manufacturer %}
  "brand": {
    "@type": "Thing",
    "name": "{{ manufacturer }}"
  },
  {% endif %}
  {% if (review_status) %} 
	{% if (rating > 0) %} 
      "reviewRating": {
        "@type": "Rating",
        "bestRating": "5",
        "ratingValue": "{{ rating }}",
        "worstRating": "4"
      }
	  "aggregateRating": {
	    "@type": "AggregateRating",
	    "ratingValue": "{{ rating }}",
	    "reviewCount": "100"
	  },
	{% endif %}
  {% endif %}
  "offers": {
    "@type": "Offer",
    "url": "https://example.com/anvil",
    {% if (not special) %} 
    	"price": "{{ price }}",
    {% else %}
    	"price": "{{ special }}",
    {% endif %}
    "itemCondition": "https://schema.org/UsedCondition",
    "availability": "https://schema.org/{% if stock == 'Out Of Stock' %}OutOfStock{% else %}InStock{% endif %}"
  }
}
</script>
