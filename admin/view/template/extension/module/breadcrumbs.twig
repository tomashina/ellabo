{% set links = {
    'Opencart Marketplace':  'https://www.opencart.com/index.php?route=marketplace/extension/info&amp;extension_id=35022',
    'Github': 'https://github.com/underr-ua/ocmod3-breadcrumbs-plus',
    'Homepage': 'https://underr.space/en/notes/projects/project-008.html',
} %}

{{ header }}
{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button
                    class="btn btn-primary"
                    data-toggle="tooltip"
                    form="form-module"
                    title="{{ button_save }}"
                    type="submit">
                    <i class="fa fa-save"></i>
                </button>
                <a
                    class="btn btn-default"
                    data-toggle="tooltip"
                    href="{{ cancel }}"
                    title="{{ button_cancel }}">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>
                {{ heading_title }}
            </h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li>
                        <a href="{{ breadcrumb.href }}">
                            {{ breadcrumb.text }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_permission %}
            <div class="alert alert-danger alert-dismissible">
                <i class="fa fa-exclamation-circle"></i>
                {{ error_permission }}
                <button
                    class="close"
                    data-dismiss="alert"
                    type="button">
                    &times;
                </button>
            </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-pencil"></i>
                    {{ text_edit }}
                </h3>
            </div>
            <div class="panel-body">
                <form
                    action="{{ action }}"
                    class="form-horizontal"
                    enctype="multipart/form-data"
                    id="form-module"
                    method="post">
                    <ul class="nav nav-tabs" id="tabs">
                        <li class="active">
                            <a data-toggle="tab" href="#tab-general">
                                {{ entry_tab_general }}
                            </a>
                        </li>
                        <li>
                            <a data-toggle="tab" href="#tab-support">
                                {{ entry_tab_support }}
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group ">
                                <label
                                    class="col-sm-2 control-label text-right"
                                    for="select-status">
                                    {{ entry_status }}
                                </label>
                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="select-status"
                                        name="module_breadcrumbs_status">
                                        <option
                                            value="0"
                                            {% if not status %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if status %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group ">
                                <div>
                                    <label
                                        class="col-sm-2 control-label text-right"
                                        for="select-path">
                                        {{ entry_breadcrumb_type }}
                                        <span
                                            data-original-title="{{ help_breadcrumb_type }}"
                                            data-toggle="tooltip"
                                            title="">
                                        </span>
                                    </label>
                                </div>
                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="select-path"
                                        name="module_breadcrumbs_type">
                                        {% for key, value in breadcrumbs_types %}

                                        <option
                                            value="{{ value }}"
                                            {% if breadcrumbs_type == value %}selected="selected"{% endif %}>
                                            {{ _context['text_breadcrumb_type_' ~ key] }}
                                        </option>

                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <div class="form-group ">
                                <label
                                    class="col-sm-2 control-label text-right"
                                    for="select-update-search">
                                    {{ entry_update_search }}
                                    <span
                                        data-original-title="{{ help_update_search }}"
                                        data-toggle="tooltip"
                                        title="">
                                    </span>
                                </label>

                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="select-update-search"
                                        name="module_breadcrumbs_update_search">
                                        <option
                                            value="0"
                                            {% if not update_search %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if update_search %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group ">
                                <label
                                    class="col-sm-2 control-label text-right"
                                    for="select-update-manufacturer">
                                    {{ entry_update_manufacturer }}
                                    <span
                                        data-original-title="{{ help_update_manufacturer }}"
                                        data-toggle="tooltip"
                                        title="">
                                    </span>
                                </label>

                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="select-update-manufacturer"
                                        name="module_breadcrumbs_update_manufacturer">
                                        <option
                                            value="0"
                                            {% if not update_manufacturer %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if update_manufacturer %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group ">
                                <label
                                    class="col-sm-2 control-label text-right"
                                    for="selectjson">
                                    {{ entry_json }}
                                    <span
                                        data-original-title="{{ help_json }}"
                                        data-toggle="tooltip"
                                        title="">
                                    </span>
                                </label>

                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="selectjson"
                                        name="module_breadcrumbs_json"
                                        {% if breadcrumbs_json_disabled %}disabled{% endif %}>
                                        <option
                                            value="0"
                                            {% if not breadcrumbs_json %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if breadcrumbs_json %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group ">
                                <label
                                    class="col-sm-2 control-label text-right"
                                    for="select-nolink">
                                    {{ entry_nolink }}
                                    <span
                                        data-original-title="{{ help_nolink }}"
                                        data-toggle="tooltip"
                                        title="">
                                    </span>
                                </label>

                                <div class="col-sm-10 text-left">
                                    <select
                                        class="form-control"
                                        id="select-nolink"
                                        name="module_breadcrumbs_nolink">
                                        <option
                                            value="0"
                                            {% if not nolink %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if nolink %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group ">
                                <label class="col-sm-2 control-label text-right" for="select-bold">
                                    {{ entry_bold }}
                                    <span data-toggle="tooltip" title="" data-original-title="{{ help_bold }}"></span>
                                </label>
                                <div class="col-sm-10 text-left">
                                    <select name="module_breadcrumbs_bold" id="select-bold" class="form-control">
                                        <option
                                            value="0"
                                            {% if not bold %}selected="selected"{% endif %}>
                                            {{ text_disabled }}
                                        </option>
                                        <option
                                            value="1"
                                            {% if bold %}selected="selected"{% endif %}>
                                            {{ text_enabled }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane" id="tab-support">
                            <div class="row">
                                <div class="col-sm-4 col-sm-offset-4">
                                    <div class="well">
                                        {% for button_name, button_link in links %}
                                        <a
                                            class="btn {% if loop.first %}btn-primary{% else %}btn-default{% endif %} btn-lg btn-block"
                                            href="{{ button_link }}"
                                            target="_blank">
                                            {{ button_name }}
                                        </a>
                                        {% endfor %}
                                    </div>
                                    <div class="text-center">
                                        © Copyright 2019-{{ 'now'|date('Y') }} Andrii Burkatskyi aka underr
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript"><!--

function disableInput(e, a = true) {
    $(e).fadeTo('fast', a ? 0.5 : 1, function() {
        $(e + ' input').prop('disabled', a ? true : false);
    });
}

if (!$('#select-path').val()) {
    disableInput('#div-path-options');
} else {
    disableInput('#div-path-options', false);
}

$('#select-path').on('change', function () {
    if (!$(this).val()) {
        disableInput('#div-path-options');
    } else {
        disableInput('#div-path-options', false);
    }

})
//--></script>
{{ footer }}
