        div.table .file-row:nth-child(odd) {
            background: #f9f9f9;
        }
        #mmos-previews{
            display: table;
            width: 100%;
            max-height: 600px;
            overflow-x: auto;

        }
        .file-row {
            display: table-row;
        }
        .file-row > div {
            display: table-cell;
            padding: 10px;
            vertical-align: middle;
        }
        .file-row:nth-of-type(odd) {
            background-color: #f9f9f9;
        }
        @media (max-width: 765px) {
            .file-row {
                display: block;
                width: 100%;
                overflow: auto;
            }
            .file-row > div {
                display: block;
                padding: 0;
                vertical-align: auto;
            }
            .file-row > div.mmos-image {
                float: left;
                width: 30%;
                padding-top: 10px;
            }
            .file-row > div.mmos-name {
                width: 70%;
                float: left;
                padding: 0;
                padding-top: 10px;
            }
            .file-row > div.mmos-size {
                width: 30%;
                float: left;
                padding: 0;
            }
            .file-row > div.mmos-action {
                padding: 0;
                width: 30%;
                float: left;
            }
        }
        .Upload-form-mmos{
            border: 2px dashed #0087F7;
            border-radius: 5px;
            background: white;
            padding: 0px 10px;
            margin: 10px;
            font-weight: 600;
        }
    </style>
  
    <section>
        <div class="col-sm-12">
            <!-- The global file processing state -->
            <span class="fileupload-process">
                <div id="total-progress" class="progress progress-striped active" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="opacity: 0;">
                    <div class="progress-bar  progress-bar-striped progress-bar-success" style="width: 100%;" data-dz-uploadprogress=""></div>
                </div>
            </span>
        </div>
    </section>
    <section>

        <div id="attachment-drop">
            
            <div class="col-sm-12">
                <div class="text-center hidden">
                    <button type="button" class="btn btn-primary start" >
                        <i class="fa fa-upload"></i>
                        <span>{{ text_start_upload }}</span>
                    </button>
                    <button type="button" class="btn btn-warning cancel">
                        <i class="fa fa-circle"></i>
                        <span>{{ text_cancel_upload }}</span>
                    </button>
                </div>
            </div>
        </div>
    </section>


</div>
